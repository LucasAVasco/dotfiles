/*
 * Base Rofi Theme — Floating Command Palette / GNOME Adwaita Dark
 */

@import "palette.rasi"

configuration {
    font:       "Adwaita Sans 11";
    icon-theme: "Adwaita";
}

window {
    width:            580px;
    padding:          16px;
    border:           1px;
    border-radius:    18px;
    border-color:     @border-default;
    background-color: @bg-window;
    location:         center;
    anchor:           center;
}

mainbox {
    spacing:          12px;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

/* Integrated recessed search pill (mirrors Quickshell TextFieldBox) */
inputbar {
    padding:          10px 16px;
    spacing:          10px;
    border:           1px;
    border-radius:    999px;
    border-color:     @border-default;
    background-color: @bg-input;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @accent-hover;
    vertical-align:   0.5;
    font:             "Adwaita Sans SemiBold 11";
}

entry {
    background-color:  transparent;
    text-color:        @fg-primary;
    placeholder:       "Search…";
    placeholder-color: @fg-muted;
    vertical-align:    0.5;
    cursor:            text;
}

case-indicator {
    enabled: false;
}

message {
    padding:          10px 14px;
    border:           1px;
    border-radius:    10px;
    border-color:     @border-subtle;
    background-color: @bg-subtle;
}

textbox {
    background-color: transparent;
    text-color:       @fg-secondary;
    vertical-align:   0.5;
}

listview {
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    fixed-height:     false;
    spacing:          4px;
    background-color: transparent;
    border:           0px;
}

element {
    orientation:      horizontal;
    padding:          10px 14px;
    spacing:          12px;
    border:           1px;
    border-radius:    10px;
    border-color:     transparent;
    background-color: transparent;
    text-color:       @fg-primary;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg-primary;
}

element normal.active,
element alternate.active {
    background-color: @bg-subtle;
    border-color:     @border-subtle;
    text-color:       @accent-hover;
}

element normal.urgent,
element alternate.urgent {
    background-color: @danger-subtle;
    border-color:     @danger-border;
    text-color:       @fg-primary;
}

element selected.normal {
    background-color: @accent-subtle;
    border-color:     @accent-border;
    text-color:       @fg-primary;
}

element selected.active {
    background-color: @accent;
    border-color:     @accent-hover;
    text-color:       @fg-on-accent;
}

element selected.urgent {
    background-color: @danger;
    border-color:     @danger-border;
    text-color:       @fg-on-accent;
}

element-icon {
    size:             22px;
    background-color: transparent;
    vertical-align:   0.5;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    cursor:           inherit;
}

/* Segmented Adwaita pill mode switcher (enabled by themes that want it) */
mode-switcher {
    spacing:          6px;
    padding:          4px;
    border:           1px;
    border-radius:    999px;
    border-color:     @border-subtle;
    background-color: @bg-input;
}

button {
    padding:          6px 14px;
    border-radius:    999px;
    background-color: transparent;
    text-color:       @fg-secondary;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           pointer;
}

button selected {
    background-color: @bg-elevated;
    text-color:       @fg-primary;
}

/* vim: set ft=css: */
