/*
 * Spacious Icon Grid Theme — GNOME App Overview inspired
 */

@theme "my-theme"

window {
    width:   780px;
    padding: 20px;
}

mainbox {
    spacing: 18px;
}

inputbar {
    margin: 0px 110px;
}

listview {
    columns:       5;
    lines:         3;
    fixed-columns: true;
    fixed-height:  true;
    dynamic:       false;
    spacing:       10px;
    scrollbar:     false;
}

element {
    orientation:   vertical;
    padding:       14px 8px;
    spacing:       10px;
    border-radius: 14px;
}

element-icon {
    size:             48px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    font:             "Adwaita Sans 10";
}

/* vim: set ft=css: */
