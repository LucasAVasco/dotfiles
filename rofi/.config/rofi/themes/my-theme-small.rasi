/*
 * Compact Popover Theme — mirrors Quickshell ModalDialog width
 */

@theme "my-theme"

window {
    width:         440px;
    padding:       16px;
    border-radius: 18px;
}

mainbox {
    spacing: 12px;
}

listview {
    lines:        5;
    dynamic:      true;
    fixed-height: false;
}

/* vim: set ft=css: */
