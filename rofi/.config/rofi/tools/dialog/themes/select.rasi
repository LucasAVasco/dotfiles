/*
 * Modal Selection Dialog — mirrors Quickshell ModalDialog
 */

configuration {
    show-icons: false;
}

@theme "my-theme-small"

window {
    width:   460px;
    padding: 18px;
}

entry {
    placeholder: "Filter options…";
}

listview {
    lines:        7;
    columns:      1;
    dynamic:      true;
    fixed-height: false;
}

/* vim: set ft=css: */
