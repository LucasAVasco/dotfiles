/*
 * Modal Text Input Dialog — mirrors Quickshell ModalDialog
 */

configuration {
    show-icons: false;
}

@theme "my-theme-small"

window {
    width:   460px;
    padding: 20px;
}

mainbox {
    spacing:  0px;
    children: [ "inputbar" ];
}

inputbar {
    padding:       12px 16px;
    border-radius: 12px;
}

entry {
    placeholder: "Type here…";
}

/* vim: set ft=css: */
