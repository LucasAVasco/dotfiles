/*
 * Window Switcher — Readable list with app icons & workspace tags
 */

configuration {
    window-format:  "{c}  ·  {t}  [{w}]";
    display-window: "󱂬  Windows";
    show-icons:     true;
}

@theme "my-theme"

window {
    width: 680px;
}

entry {
    placeholder: "Switch window…";
}

listview {
    lines:        7;
    columns:      1;
    dynamic:      true;
    fixed-height: false;
}

element {
    padding: 10px 14px;
    spacing: 14px;
}

element-icon {
    size: 28px;
}

/* vim: set ft=css: */
