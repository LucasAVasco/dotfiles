" Command macros documentation: https://vifm.info/manual.shtml#Command%20macros

" Toggle selection and move down
noremap <Space> t;j

" Movement
nnoremap <A-d> <C-d>
nnoremap <A-u> <C-u>
nnoremap g<Space> :filechooser<CR>
nnoremap gzz :zoxide<CR>
noremap gza :!zoxide add %f<CR>

" Open folders
nnoremap gM :cd /media/<CR>
nnoremap gm :cd /run/media/$USER<CR>
nnoremap gp :cd $HOME/Pictures/<CR>
nnoremap gr :cd $HOME/Repositories/<CR>
nnoremap gd :cd $HOME/Downloads/<CR>
nnoremap gD :cd $HOME/.local/share/vifm/Trash/<CR>
nnoremap gH :cd $HOME<CR>
nnoremap gS :cd /home/shared_folder/<CR>
nnoremap gnc :!NOTIFY_SEND=y nvim-proj open-config<CR>
nnoremap gnp :!NOTIFY_SEND=y nvim-proj open<CR>
nnoremap gnr :cd $HOME/Repositories/neovim_repos/<CR>

" Tabs
let g:lasttab = 1
nnoremap <A-A> :let g:lasttab = tabpagenr() | tabnew<CR>
nnoremap <esc>] :let g:lasttab = tabpagenr() | tabnext<CR>
nnoremap <esc>[ :let g:lasttab = tabpagenr() | tabprev<CR>
nnoremap <esc>} :let g:lasttab = tabpagenr() | execute 'tabmove' tabpagenr()+1<CR>
nnoremap <esc>{ :let g:lasttab = tabpagenr() | execute 'tabmove' tabpagenr()-2<CR>
nnoremap <A-1> :let g:lasttab = tabpagenr() | tabnext 1 <CR>
nnoremap <A-2> :let g:lasttab = tabpagenr() | tabnext 2 <CR>
nnoremap <A-3> :let g:lasttab = tabpagenr() | tabnext 3 <CR>
nnoremap <A-4> :let g:lasttab = tabpagenr() | tabnext 4 <CR>
nnoremap <A-5> :let g:lasttab = tabpagenr() | tabnext 5 <CR>
nnoremap <A-6> :let g:lasttab = tabpagenr() | tabnext 6 <CR>
nnoremap <A-7> :let g:lasttab = tabpagenr() | tabnext 7 <CR>
nnoremap <A-8> :let g:lasttab = tabpagenr() | tabnext 8 <CR>
nnoremap <A-9> :let g:lasttab = tabpagenr() | tabnext 9 <CR>
nnoremap <BS> :let g:nextlasttab = tabpagenr() | execute "tabnext ".g:lasttab | let g:lasttab = g:nextlasttab<cr>
nnoremap <A-w> :quit<CR>

" I do not like to open the file with 'l' and 'right'
nnoremap l :if filetype('.', 1) == "dir" | cd %c | endif<CR>
nnoremap <right> :if filetype('.', 1) == "dir" | cd %c | endif<CR>

" Search
nnoremap ch :nohlsearch<CR>

" Hidden files
nnoremap g. za

" Clipboard
nnoremap <A-p> :!clear && INTERACTIVE_SHELL=y clip-paste --ask-type --ask-out-file<CR>
noremap yd :!clip-copy %d:p<CR>
noremap yf :!clip-copy %f:p<CR>

" Open apps
nnoremap <A-t> :!run-without-env default_term<CR>
nnoremap <A-f> :!run-without-env default_file_manager<CR>
nnoremap <CR> :defaultopen<CR>
nnoremap <A-e> :!run-without-env default_text_editor %f<CR>
vnoremap <A-e> :!run-without-env default_text_editor %f<CR>

" Permissions
noremap <A-x> :!chmod u+x %f<CR>
noremap <A-S-x> :!chmod u-x %f<CR>

" Create files and directories
nnoremap O :t<Space>
nnoremap o :t<Space>

" Visual mode
nnoremap v av

" Command mode {{{

" Go to beginning of the previous word with CTRL+LEFT
cnoremap <esc>[1;5D <A-b>

" Go to en of the next word with CTRL+RIGHT
cnoremap <esc>[1;5C <A-f>

" Delete the next word with CTRL+DELETE
cnoremap <esc>[3;5~ <A-d>

" }}}
