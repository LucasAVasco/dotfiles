" Movement
bind <A-[> tabprev
bind <A-]> tabnext
bind <A-{> tabmove -1
bind <A-}> tabmove +1
bind <A-d> scrollpage 0.5
bind <A-u> scrollpage -0.5
" Alternate buffer
bind <A-Bs> tab #
bind <A-0> tablast

" Search mode
bind / fillcmdline find
bind ch nohlsearch

" Window management
bind <A-w> tabclose
bind O fillcmdline tabopen

" Editor
bind --mode=insert <C-e> editor
set editorcmd default_text_editor_synced

" vi: ft=vim
