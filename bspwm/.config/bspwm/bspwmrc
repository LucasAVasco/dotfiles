#! /bin/bash
#
# This script is run only once when the bspwm window manager is started
#
# Commands that can be executed more that once need to be placed in the 'init.sh'

# Desktops
bspc monitor -d I II III IV V VI VII VIII IX X

# Logout command
export CUSTOM_DESKTOP_LOGOUT_COMMAND="$HOME/.config/bspwm/quit.sh"

# Scripts that can be executed more that once
~/.config/bspwm/init.sh
