# Configuration to work with Bspwm window manager
#
# To query the X events used to define the keybindings, use: xev
# To reload Sxhkd and apply the changes, use: pkill -USR1 -x sxhkd

# Exit and reload

super + ctrl + shift + q
	~/.config/bspwm/quit.sh &

super + shift + x
	~/.config/bspwm/init.sh &


# Applications

super + Return
	cd ~; default_term &

super + f
	cd ~; default_file_manager &

super + w
	~/.local/dotfiles_bin/default_web_browser &

super + t
	~/.config/custom-desktop/chdesk-ui.sh &

super + a
	~/.config/custom-desktop/launcher.sh &

super + o
	~/.config/custom-desktop/org-menu.sh &

super + r
	~/.local/dotfiles_bin/custom-script-popup &

super + shift + p
	~/.config/custom-desktop/password-manager.sh &

super + s
	~/.config/screenshot/take.sh -o /dev/null -c &

super + shift + s
	~/.config/screenshot/take.sh -o /dev/null -i -c &

super + shift + Escape
	~/.config/custom-desktop/session-manager.sh &


# Close window

super + c
	bspc node -c

super + Delete
	xkill &


# Directions

super + {h,j,k,l}
	bspc node -f {west,south,north,east}

super + alt + {h,j,k,l}
	bspc node -s {west,south,north,east} --follow

super + shift + h
	bspc node -z left -20 0

super + shift + j
	bspc node -z bottom 0 20

super + shift + k
	bspc node -z top 0 -20

super + shift + l
	bspc node -z right 20 0


# Node creation

super + ctrl + {h,j,k,l,g}
	bspc node -p {west,south,north,east,cancel}


# Workspaces / desktops

super + {1-5}
	bspc desktop -f {I,II,III,IV,V} & ~/.config/monitor/update-workspace-screen-temp.sh 1

super + F{1-5}
	~/.config/monitor/update-workspace-screen-temp.sh 6 & bspc desktop -f {VI,VII,VIII,IX,X}

super + alt + {1-5}
	bspc node -d {I,II,III,IV,V} --follow & ~/.config/monitor/update-workspace-screen-temp.sh 1

super + alt + F{1-5}
	~/.config/monitor/update-workspace-screen-temp.sh 6 & bspc node -d {VI,VII,VIII,IX,X} --follow

super + shift + {1-5}
	bspc node -d {I,II,III,IV,V}

super + shift + F{1-5}
	bspc node -d {VI,VII,VIII,IX,X}

super + BackSpace
	bspc desktop -f last

super + bracketright
	bspc desktop -f next.local

super + bracketleft
	bspc desktop -f prev.local


# Monitors

super + ctrl + {1-5}
	bspc monitor -f ^{1-5}

super + ctrl + alt + {1-5}
	bspc node -m ^{1-5} --follow

super + ctrl + shift + {1-5}
	bspc node -m ^{1-5}


# Node management

super + 0
	bspc node -t '~floating'

super + 9
	bspc node -t floating; bspc node -g sticky=on

super + 8
	bspc node -t fullscreen

super + 7
	bspc node -t pseudo_tiled

super + 6
	bspc node -R 90

super + minus
	bspc node -g sticky


# Layout management

super + m
	bspc desktop -l next

super + shift + m
	bspc desktop -l prev


# Notifications

super + shift + n
	~/.config/custom-desktop/dismiss-notifications.sh &


# Clipboard management

super + y
	~/.local/dotfiles_bin/receive-clip-from-sync-folder &

super + p
	~/.local/dotfiles_bin/send-clip-to-sync-folder &

super + shift + y
	~/.config/clipboard/clear.sh &


# Screen locker

super + z
	~/.config/screenlocker/manager.sh toggle &

ctrl + alt + l
	~/.config/screenlocker/manager.sh run &


# Backlight

super + F6
	backlight set -5%

super + F7
	backlight set 20%

super + F8
	backlight set +5%


# Sound and volume

super + F9
	pactl set-sink-mute @DEFAULT_SINK@ toggle

super + F10
	pactl set-sink-volume @DEFAULT_SINK@ -5%

super + F11
	pactl set-sink-volume @DEFAULT_SINK@ +5%

super + b
	~/.config/keyboard/sound_emulator.sh toggle


# Mouse and simulated input

super + e
	simulate-input mouse scroll 5 20 0 -15

super + u
	simulate-input mouse scroll 5 20 0 -15

super + d
	simulate-input mouse scroll 5 20 0 15

super + shift + d
	simulate-input mouse click middle

super + button4
	bspc desktop -f prev.local

super + button5
	bspc desktop -f next.local

super + button1
	bspc pointer -g move

super + button3
	bspc pointer -g resize_corner
