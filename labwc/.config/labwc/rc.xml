  <keyboard>
    <default />

    <keybind key="C-S-c">
      <action name="Close" />
    </keybind>

    <keybind key="C-S-a">
      <action name="Execute" command="~/.config/rofi/tools/applications.sh" />
    </keybind>
  </keyboard>
</labwc_config>
