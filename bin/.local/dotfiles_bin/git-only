#!/bin/bash
#
# Command to hide all changed/untracked files except for the given patterns.

set -e

source ~/.local/lib/dotfiles/bash/help.sh

help_handle y "$@" << EOF
	Command to hide all changed/untracked files except for the given patterns.

	Usage:
		git-only <patterns...>

	Arguments:
		<patterns...> Paths to hide. Supports the same format as the 'git stash push' command
EOF

# exclude the patterns
declare -a patterns=()
for i in "$@"; do
	patterns+=(":(exclude)$i")
done

# Show all files and then hides the patterns
git hide -u
git hide -- "${patterns[@]}"
