#!/bin/bash
#
# Simple script to convert several images from on format to another.
#
# Dependencies: ImageMagick

set -e

source ~/.local/lib/dotfiles/bash/help.sh

help_handle y "$@" <<EOF
	Converts several images from one format to another. The formats must be supported by ImageMagick

	Usage:
		img-convert -f <new-format> [files...]

	Flags:
	-f, --format   <new-format> The new format. Must be the same name of the extension of the new format (example: png, jpg, etc.)

	Examples:
		img-convert -f png *.jpg # Converts all .jpg files to .png
EOF

# Parses arguments
if [[ "$1" != "-f" && "$1" != "--format" ]]; then
	echo "Usage: img-convert [-f|--format] <format> [files...]"
	exit 1
fi

shift
format="$1"
shift

# Converts a video to a given format.
#
# $1: Source file.
# $2: Destination format.
convert_video_to_format() {
	local source_file="$1"
	local extension="$2"

	# File properties
	local stem="$(basename $source_file | cut -d '.' -f 1)" # `basename` gets only the file name. `cut` removes the extension
	local dirname="$(dirname $source_file)"
	local dest_file="${dirname}/${stem}.${extension}"

	# Conversion
	echo "Converting '$source_file' to '$dest_file'"
	magick "$source_file" "$dest_file" && echo "Done!"
}


for source_file in "$@"; do
	convert_video_to_format "$source_file" "$format"
done
