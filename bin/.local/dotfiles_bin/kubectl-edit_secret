#!/bin/bash
#
# Edit Kubernetes secrets.

source ~/.local/lib/dotfiles/bash/strict.sh

source ~/.local/lib/dotfiles/bash/help.sh

help_handle y "$@" <<'EOF'
	Edit Kubernetes secrets.

	Usage:
	  edit-secret [OPTIONS] SECRET [KEY]

	Arguments:
	  SECRET                Name of the Kubernetes secret.
	  KEY                   Secret key to edit. If omitted, all keys are
	                        extracted and opened in the editor.

	Options:
	  -n, --namespace NAME  Kubernetes namespace.
	      --suffix SUFFIX   Suffix for temporary directories.
	  -h, --help            Show this help message.

	Examples:
	  edit-secret my-secret
	  edit-secret my-secret password
	  edit-secret -n production my-secret
	  edit-secret -n production my-secret password

	When editing all keys, each key is represented by a separate file:
	  - Edit a file to change its value.
	  - Create a file to add a new key.
	  - Delete a file to remove a key.

	The directory contents are used to rebuild the secret's data.
EOF

# Options
namespace=''
suffix=''

while (($#)); do
	case "$1" in
		-n | --namespace)
			(($# >= 2)) || {
				echo "Missing value for $1" >&2
				exit 1
			}
			namespace="$2"
			shift 2
			;;

		--suffix)
			(($# >= 2)) || {
				echo "Missing value for $1" >&2
				exit 1
			}
			suffix="$2"
			shift 2
			;;

		--)
			shift
			break
			;;

		-*)
			echo "Unknown option: $1" >&2
			exit 1
			;;

		*)
			break
			;;
	esac
done

# Validation
if (($# < 1 || $# > 2)); then
	echo 'Expected SECRET [KEY]' >&2
	exit 1
fi

# Positional arguments
secret="$1"
key="${2:-}"

args=()
if [[ -n "$namespace" ]]; then
	args+=(-n "$namespace")
fi

# Create separate temporary directories for editable files and metadata.
temp_dir=$(mktemp -d)
metadata_dir=$(mktemp -d)

trap 'rm -rf -- "$temp_dir" "$metadata_dir"' EXIT

secret_file="$metadata_dir/secret.json"
patch_file="$metadata_dir/patch.json"

# Fetch the secret.
kubectl get secret "${args[@]}" "$secret" -o json > "$secret_file"

if [[ -n "$key" ]]; then
	# Edit a single key.
	temp_file="$temp_dir/$key"

	jq -r --arg key "$key" '.data[$key] // empty' "$secret_file" |
		base64 -d > "$temp_file"

	nvim "$temp_file"

	# Build a JSON Patch replacing the entire data object.
	jq -n \
		--arg key "$key" \
		--arg value "$(base64 -w 0 "$temp_file")" \
		'[{
			op: (if $key then "add" else "add" end),
			path: ("/data/" + $key),
			value: $value
		}]' > "$patch_file"
else
	# Edit all keys.
	while IFS= read -r key; do
		jq -r --arg key "$key" '.data[$key]' "$secret_file" |
			base64 -d > "$temp_dir/$key"
	done < <(jq -r '.data // {} | keys[]' "$secret_file")

	# Open the directory in the editor.
	nvim "$temp_dir"

	# Rebuild the complete data object from the directory contents.
	patch_data='{}'

	while IFS= read -r -d '' file; do
		key="${file##*/}"
		encoded=$(base64 -w 0 "$file")

		patch_data=$(
			jq -c \
				--arg key "$key" \
				--arg value "$encoded" \
				'. + {($key): $value}' <<< "$patch_data"
		)
	done < <(find "$temp_dir" -mindepth 1 -maxdepth 1 -type f -print0)

	# Replace the entire data object.
	jq -n \
		--argjson data "$patch_data" \
		'[{
			op: "add",
			path: "/data",
			value: $data
		}]' > "$patch_file"
fi

# Apply changes using JSON Patch.
kubectl patch secret "${args[@]}" "$secret" \
	--type=json \
	-p "$(cat "$patch_file")"

