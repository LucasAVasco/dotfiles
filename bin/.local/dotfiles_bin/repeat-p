#!/bin/bash
#
# Repeat a command in parallel.

source ~/.local/lib/dotfiles/bash/strict.sh

source ~/.local/lib/dotfiles/bash/help.sh

help_handle y "$@" <<EOF
	Repeat a command in parallel. Any '/_' will be replaced with the current iteration. This placeholder can be configured with the
	'--placeholder' flag.

	Usage: repeat-p [-p|--placeholder <placeholder>] <num-repeat> <command> [args...]

	Options:
		-p, --placeholder <placeholder>  The placeholder to replace with the current iteration. To disable, set to ''.
EOF

placeholder='/_'
if [[ "$1" == '-p' || "$1" == '--placeholder' ]]; then
	placeholder="$2"
	shift 2
fi

if [[ "$#" -lt 1 ]]; then
	echo "Must provide at least one command to repeat in parallel."
fi

repeat="$1"
shift

# Aborts all jobs on exit
abort_all_jobs() {
	kill $(jobs -p) 2>/dev/null || true
}
trap abort_all_jobs EXIT

# Repeats the command
pids=()
for i in $(seq 1 $repeat); do
	# Replaces the placeholder in the command
	cmd=()
	if [[ -n "$placeholder" ]]; then
		for arg in "$@"; do
			cmd+=("$(printf '%s' "$arg" | strsubst "$placeholder" "$i")")
		done
	else
		cmd+=("$@")
	fi

	# Runs the command
	command "${cmd[@]}" &
	pids+=($!)
done

# Waits for all jobs to complete. If any job fails, returns the exit code of the first failed job
for _ in "${pids[@]}"; do
	wait -n
	exit_code=$?

	if [[ $exit_code -ne 0 ]]; then
		break
	fi
done

if [ $exit_code -ne 0 ]; then
	echo "Error: A background job failed with exit code $exit_code. Exiting now!"

	exit $exit_code
fi
