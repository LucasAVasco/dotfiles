#!/bin/bash
#
# Run a command for each line of stdin

set -e

source ~/.local/lib/dotfiles/bash/help.sh

help_handle y "$@" <<EOF
	Run a command for each line of the received standard input. Replaces all '/_' arguments in the command by the current line

	Usage: foreach-line [-d] [-s] [-m] -- <command>

	Flags:
		-d, --debug     Enable debug mode
		-s, --shell     Run the command in a subshell
		-m, --match     Match '/_' within arguments instead of requiring an exact match
EOF

# Command line options
debug=n
run_in_shell=n
match_substrings=n

while [[ $# -gt 0 ]]; do
	case "$1" in
		-d | --debug)
			debug=y
			;;

		-s | --shell)
			run_in_shell=y
			;;

		-m | --match)
			match_substrings=y
			;;

		--)
			shift
			break
			;;

		*)
			break
			;;
	esac

	# Next argument
	shift
done

# Main loop
while IFS= read -r line || [[ -n "$line" ]]; do
	cmd=("$@")

	# Replace '/_' in command arguments
	for ((i = 0; i < ${#cmd[@]}; i++)); do
		if [[ "$match_substrings" == 'y' ]]; then
			cmd[$i]="${cmd[$i]//\/_/$line}"
		elif [[ "${cmd[$i]}" == '/_' ]]; then
			cmd[$i]="$line"
		fi
	done

	# Debug info
	if [[ "$debug" == 'y' ]]; then
		echo '---'
		printf '\e[0;34mInput:\e[0m %s\n' "${line}"
		printf '\e[0;34mRunning:\e[0m %s\n' "${cmd[*]}"
	fi

	# Runs the command in a subshell to avoid polluting the environment
	(
		if [[ "$run_in_shell" == 'y' ]]; then
			shell="${SHELL-bash}"
			"$shell" -c "${cmd[*]}"
		else
			command "${cmd[@]}"
		fi
	)
done
