#!/bin/bash
#
# Run a command in a detached session.
#
# $1: the command to run.
# $2..n: the arguments to pass to the command.

# The command is run in a detached session, so it's not interactive
export INTERACTIVE_SHELL=''

# Check if systemd-run exists and the user D-Bus/systemd session is active
if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1; then
	env_args=()
	while IFS='=' read -r -d '' name value; do
		# Skip systemd-specific or read-only variables that shouldn't be overridden
		case "$name" in
			_|SHLVL|PWD|OLDPWD|SYSTEMD_*|INVOCATION_ID|JOURNAL_STREAM) continue ;;
		esac
		env_args+=("--setenv=${name}=${value}")
	done < <(env -0)

	exec systemd-run --user --working-directory="$PWD" "${env_args[@]}" "$@" >/dev/null 2>&1
else
	# Fallback to 'setsid'
	setsid --fork "$@" >/dev/null 2>&1 </dev/null &
	disown
fi
