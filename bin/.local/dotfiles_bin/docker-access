#!/bin/bash
#
# Configure ownership and access control to allow the host user to access files generated by a root-less container.

# cspell:words rootlesskit

set -e

source ~/.local/lib/dotfiles/bash/help.sh
source ~/.local/lib/dotfiles/bash/dialog/dialog.sh

help_handle y "$@" <<EOF
	Configure ownership and access control to allow the host user to access files generated by a root-less container.

	Root-less containers remap the root user inside the container to the host user. Files remapped will have a different UID from the host
	user and can not be accessed by the host user.

	This script configures access control to allow the user to access the files and optionally change the ownership of the files to one of
	the container's users.

	Usage:
		docker-access <path>

	Flags:
		-u, --uid <user>   Change the ownership of the files to the specified user inside the container
EOF

# Command line flags
container_uid=""
while [[ $# -gt 0 ]]; do
	case "$1" in
		-u | --uid)
			container_uid="$2"
			shift
			;;

		--)
			shift
			break
			;;

		*)
			break
			;;
	esac

	shift
done

if [[ $# -eq 0 ]]; then
	echo "Error: No files specified" >&2
	exit 1
fi

# Check if the user wants to change the ownership
if [[ $(dialog_ask_boolean "Change the ownership and access control of these files? $*" 'n') == 'n' ]]; then
	exit 0
fi

# Set access control for all files. 'root' is mapped to the host user inside the container
find "$@" -print0 | while IFS= read -r -d '' item; do
	if [ -d "$item" ]; then
		rootlesskit setfacl -m "u:root:rwx" "$item" # Directories must have 'x' to be traversable

		# Set default ACLs for directories (inheritance)
		rootlesskit setfacl -d -m "u:root:rwx" "$item"
		rootlesskit setfacl -d -m "m::rwx" "$item"

	elif [ -x "$item" ]; then # Is executable
		rootlesskit setfacl -m "u:root:rwx" "$item"

	else
		rootlesskit setfacl -m "u:root:rw-" "$item"
	fi
done

# Set default ACLs for files
rootlesskit setfacl -R -m "m::rwx" "$@"

# Change ownership
if [[ -n "$container_uid" ]]; then
	rootlesskit chown -R "$container_uid:$container_uid" "$@"
fi
