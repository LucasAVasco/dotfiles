#!/bin/bash
#
# Run a command with a pretty header and footer
#
# $@: Command to run and arguments

# Shows the current time and command to run
echo -e "\u001b[1;33m󰃭 $(date)\u001b[0m \033[0;36m $@\u001b[0m"

# Runs the command
command "$@"
last_exit_code=$?

# Shows the result
echo "" # Newline
if [ $last_exit_code -eq 0 ]; then
	echo -e "\u001b[1;32m Command succeeded\u001b[0m"
else
	echo -e "\n\u001b[1;31m Command failed with exit code\u001b[0m: $?"
fi
