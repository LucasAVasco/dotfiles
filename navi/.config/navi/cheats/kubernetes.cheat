% Kubernetes, k8s


$ var-service-at-port-80: kubectl get svc | grep '80/TCP' | cut -d' ' -f1

$ var-service-at-port-433: kubectl get svc | grep '433/TCP' | cut -d' ' -f1

$ kubeconfig-files-var: find -maxdepth 1 -name '*.yaml'

# Show deployments
kubectl get deployments

# Show services
kubectl get services

# Show pods
kubectl get pods -A

# Show events
kubectl get events | less

# Show logs
kubectl logs

# delete service
kubectl delete service <service-name>

# Delete deployment
kubectl delete deployment <deployment-name>

# Port forward from local host to resource
kubectl port-forward <resource> <localhost-port>:<resource-port>

# Port forward a ingress (port 80) to port 8000 (useful if running rootless)
kubectl port-forward svc/<var-service-at-port-80> 8000:80

# Port forward a ingress (port 433) to port 8443 (useful if running rootless)
kubectl port-forward svc/<var-service-at-port-433> 8443:433

# Merge configuration files
KUBECONFIG=~/.kube/config:<kubeconfig-files-var> kubectl config view --flatten | bat -l yaml
