{
	"Full name of the app": {
		"prefix": "name",
		"description": "Full name of the app",
		"body": "name: {{ .Release.Name }}-{{ .Chart.Name }}$0"
	},

	"Sample labels": {
		"prefix": "labels",
		"description": "Sample labels",
		"body": [
			"labels:",
			"\tapp.kubernetes.io/name: {{ .Chart.Name }}",
			"\tapp.kubernetes.io/instance: {{ .Release.Name }}",
			"\tapp.kubernetes.io/version: {{ .Chart.AppVersion | quote }}",
			"\tapp.kubernetes.io/component: ${1:component-in-this-chart}",
			"\tapp.kubernetes.io/part-of: ${2:higher-level-component}",
			"\tapp.kubernetes.io/managed-by: {{ .Release.Service }}",
			"\thelm.sh/chart: {{ .Chart.Name }}-{{ .Chart.Version | replace \"+\" \"_\" }}$0"
		]
	},

	"Selector content": {
		"prefix": "selector-content",
		"description": "Selector content",
		"body": [
			"app.kubernetes.io/name: {{ .Chart.Name }}",
			"app.kubernetes.io/instance: {{ .Release.Name }}",
			"app.kubernetes.io/component: ${1:component-in-this-chart}$0"
		]
	}
}
